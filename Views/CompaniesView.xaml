<UserControl x:Class="Bewerbro.Views.CompaniesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="15">

        <Border Background="#DFE0E5"
                CornerRadius="18"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->

                <TextBlock Text="Companies"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#4D3F72"
                           Margin="0,0,0,20"/>

                <!-- Input Area -->

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,20">

                    <!-- Company -->

                    <StackPanel Margin="0,0,15,0">

                        <TextBlock Text="Company Name"
                                   Margin="0,0,0,5"
                                   Foreground="#1F2937"/>

                        <TextBox Width="220"
                                 Height="32"
                                 Padding="6"
                                 Background="White"
                                 BorderBrush="#8A7C9C"
                                 BorderThickness="2"
                                 Text="{Binding NewCompanyName}" />

                    </StackPanel>

                    <!-- City -->

                    <StackPanel Margin="0,0,15,0">

                        <TextBlock Text="City"
                                   Margin="0,0,0,5"
                                   Foreground="#1F2937"/>

                        <TextBox Width="180"
                                 Height="32"
                                 Padding="6"
                                 Background="White"
                                 BorderBrush="#8A7C9C"
                                 BorderThickness="2"
                                 Text="{Binding NewCompanyCity}" />

                    </StackPanel>

                    <!-- Website -->

                    <StackPanel Margin="0,0,15,0">

                        <TextBlock Text="Website"
                                   Margin="0,0,0,5"
                                   Foreground="#1F2937"/>

                        <TextBox Width="260"
                                 Height="32"
                                 Padding="6"
                                 Background="White"
                                 BorderBrush="#8A7C9C"
                                 BorderThickness="2"
                                 Text="{Binding NewCompanyWebsite}" />

                    </StackPanel>

                    <!-- Button -->

                    <Button Content="Add Company"
                            Width="150"
                            Height="35"
                            VerticalAlignment="Bottom"
                            Background="#4D3F72"
                            Foreground="White"
                            BorderThickness="0"/>

                </StackPanel>

                <!-- DataGrid -->

                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Companies}"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderBrush="#8A7C9C"
                          BorderThickness="2"
                          GridLinesVisibility="None"
                          RowBackground="#F8F8FA"
                          AlternatingRowBackground="#EDE8F3">

                    <!-- Header -->

                    <DataGrid.ColumnHeaderStyle>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#8A7C9C"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            <Setter Property="Height"
                                    Value="35"/>

                        </Style>

                    </DataGrid.ColumnHeaderStyle>

                    <!-- Selected Row -->

                    <DataGrid.RowStyle>

                        <Style TargetType="DataGridRow">

                            <Setter Property="Foreground"
                                    Value="#1F2937"/>

                            <Style.Triggers>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#4D3F72"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.RowStyle>

                    <!-- Columns -->

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding Name}"
                                            Width="2*" />

                        <DataGridTextColumn Header="City"
                                            Binding="{Binding City}"
                                            Width="*" />

                        <DataGridTextColumn Header="Website"
                                            Binding="{Binding Website}"
                                            Width="3*" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>