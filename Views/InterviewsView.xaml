<UserControl x:Class="Bewerbro.Views.InterviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="15">

        <Grid.Resources>

            <Style TargetType="TextBox">

                <Setter Property="BorderBrush"
                Value="#8A7C9C"/>

                <Setter Property="BorderThickness"
                Value="2"/>

                <Setter Property="Background"
                Value="White"/>

                <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="TextBox">

                            <Border x:Name="Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">

                                <ScrollViewer x:Name="PART_ContentHost"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsKeyboardFocused"
                                 Value="True">

                                    <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#4D3F72"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

        </Grid.Resources>

        <Border Background="#DFE0E5"
                CornerRadius="18"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->

                <TextBlock Text="Interviews"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#4D3F72"
                           Margin="0,0,0,20"/>

                <!-- Input Area -->

                <StackPanel Grid.Row="1"
            Margin="0,0,0,20">

                    <!-- Row 1 -->

                    <WrapPanel Margin="0,0,0,10">

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Company"
                       Margin="0,0,0,5"/>

                            <TextBox Width="180"
                     Text="{Binding NewCompany}" />

                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Position"
                       Margin="0,0,0,5"/>

                            <TextBox Width="420"
                     Text="{Binding NewPosition}" />

                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Date"
                       Margin="0,0,0,5"/>

                            <TextBox Width="100"
                     Text="{Binding NewInterviewDate}" />

                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Time"
                       Margin="0,0,0,5"/>

                            <TextBox Width="80"
                     Text="{Binding NewInterviewTime}" />

                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Contact Person"
                       Margin="0,0,0,5"/>

                            <TextBox Width="220"
                     Text="{Binding NewContactPerson}" />
                        </StackPanel>

                    </WrapPanel>

                    <!-- Row 2 -->

                    <WrapPanel Margin="0,0,0,10">

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Meeting Link / Address"
                   Margin="0,0,0,5"/>

                            <TextBox Width="1050"
                 Text="{Binding NewLocation}" />

                        </StackPanel>

                        <StackPanel>

                            <TextBlock Text="Status"
                   Margin="0,0,0,5"/>

                            <TextBox Width="120"
                 Text="{Binding NewStatus}" />

                        </StackPanel>

                    </WrapPanel>
                    <!-- Row 3 -->

                    <StackPanel Margin="0,0,0,15">

                        <TextBlock Text="Notes"
                   Margin="0,0,0,5"/>

                        <TextBox Height="70"
                 Width="1320"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Text="{Binding NewNotes}" />

                    </StackPanel>

                    <!-- Buttons -->

                    <StackPanel Orientation="Horizontal">

                        <!-- Add -->

                        <Button Content="Add"
                                Width="120"
                                Height="35"
                                Margin="0,0,10,0"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding AddInterviewCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="ButtonBorder"
                                            Background="#4D3F72"
                                            CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#8A7C9C"/>

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#3E315D"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <!-- Update -->

                        <Button Content="Update"
                                Width="120"
                                Height="35"
                                Margin="0,0,10,0"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding UpdateInterviewCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="ButtonBorder"
                                            Background="#8A7C9C"
                                            CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#A69AB4"/>

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#6F6480"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <!-- Delete -->

                        <Button Content="Delete"
                                Width="120"
                                Height="35"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding DeleteInterviewCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="ButtonBorder"
                                            Background="#B15C8F"
                                            CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#D88AB8"/>

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter TargetName="ButtonBorder"
                                                    Property="Background"
                                                    Value="#944875"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </StackPanel>

                <!-- DataGrid -->

                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Interviews}"
                          SelectedItem="{Binding SelectedInterview}"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderBrush="#8A7C9C"
                          BorderThickness="2"
                          GridLinesVisibility="None"
                          RowBackground="#F8F8FA"
                          AlternatingRowBackground="#EDE8F3">

                    <DataGrid.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#4D3F72"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                         Color="#4D3F72"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="White"/>

                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#8A7C9C"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            <Setter Property="Height"
                                    Value="35"/>

                        </Style>

                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding Company}"
                                            Width="2*" />

                        <DataGridTextColumn Header="Position"
                                            Binding="{Binding Position}"
                                            Width="2*" />

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding InterviewDate}"
                                            Width="*" />

                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding InterviewTime}"
                                            Width="*" />

                        <DataGridTextColumn Header="Meeting"
                                            Binding="{Binding Location}"
                                            Width="2*" />

                        <DataGridTextColumn Header="Contact"
                                            Binding="{Binding ContactPerson}"
                                            Width="*" />

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="*" />

                        <DataGridTextColumn Header="Notes"
                                            Binding="{Binding Notes}"
                                            Width="2*" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>