<UserControl x:Class="Bewerbro.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Applications"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,15">

            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Position"
                   Margin="0,0,0,5"/>

                <TextBox Width="220"
                 Text="{Binding NewJobTitle}" />

            </StackPanel>

            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Company"
                   Margin="0,0,0,5"/>

                <TextBox Width="220"
                 Text="{Binding NewCompany}" />

            </StackPanel>

            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Status"
                   Margin="0,0,0,5"/>

                <TextBox Width="120"
                 Text="{Binding NewStatus}" />

            </StackPanel>

            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Application Date"
                   Margin="0,0,0,5"/>

                <TextBox Width="120"
                 Text="{Binding NewApplicationDate}" />

            </StackPanel>

            <Button Content="Add"
            Width="90"
            Height="30"
            VerticalAlignment="Bottom"
            Margin="0,0,10,0"
            Command="{Binding AddApplicationCommand}" />

            <Button Content="Update"
            Width="90"
            Height="30"
            VerticalAlignment="Bottom"
            Margin="0,0,10,0"
            Command="{Binding UpdateApplicationCommand}" />

            <Button Content="Delete"
            Width="90"
            Height="30"
            VerticalAlignment="Bottom"
            Command="{Binding DeleteApplicationCommand}" />

        </StackPanel>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Applications}"
                  SelectedItem="{Binding SelectedApplication}">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Company"
                        Binding="{Binding Company}"
                        Width="2*" />

                <DataGridTextColumn Header="Position"
                        Binding="{Binding JobTitle}"
                        Width="3*" />

                <DataGridTextColumn Header="Status"
                        Binding="{Binding Status}"
                        Width="*" />

                <DataGridTextColumn Header="Application Date"
                        Binding="{Binding ApplicationDate}"
                        Width="*" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>