<Window x:Class="Bewerbro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Bewerbro.Views"
        xmlns:vm="clr-namespace:Bewerbro.ViewModels"
        mc:Ignorable="d"
        Title="Bewerbro"
        Height="700"
        Width="1200"
        Background="#F8F8FA">

    <Window.Resources>

        <!-- Navigation Button Style -->

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="Background"
                    Value="#DFE0E5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8A7C9C"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <!-- Pressed -->

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4D3F72"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ViewModel -> View Mapping -->

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
            <views:ApplicationsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
            <views:CompaniesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InterviewsViewModel}">
            <views:InterviewsView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#1F2937">

            <TextBlock Text="{Binding ApplicationTitle}"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="25,0,0,0"/>

        </Border>

        <!-- NAVIGATION -->

        <Border Grid.Row="1"
                Background="#F8F8FA">

            <StackPanel Orientation="Horizontal"
                        Margin="15,5">

                <Button Content="Dashboard"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding ShowDashboardCommand}"/>

                <Button Content="Companies"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding ShowCompaniesCommand}"/>

                <Button Content="Applications"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding ShowApplicationsCommand}"/>

                <Button Content="Interviews"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding ShowInterviewsCommand}"/>

            </StackPanel>

        </Border>

        <!-- CONTENT -->

        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentViewModel}"/>

    </Grid>

</Window>