<Window x:Class="Bewerbro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bewerbro"
        mc:Ignorable="d"
        Title="Bewerbro"
Height="700"
Width="1200">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
            Background="#2C3E50">

            <TextBlock Text="{Binding ApplicationTitle}"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0"/>
        </Border>

        <!-- Navigation -->

        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Background="#ECF0F1">

            <Button Content="Dashboard"
                Width="120"
                Margin="5"/>

            <Button Content="Companies"
                Width="120"
                Margin="5"/>

            <Button Content="Applications"
                Width="120"
                Margin="5"/>

            <Button Content="Interviews"
                Width="120"
                Margin="5"/>
        </StackPanel>

        <!-- Content Area -->

        <Grid Grid.Row="2">

            <TextBlock Text="Arbeitsbereich"
                   FontSize="24"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        </Grid>

    </Grid>
</Window>
