<Window x:Class="Bewerbro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Bewerbro.Views"
        mc:Ignorable="d"
        Title="Bewerbro"
        Height="700"
        Width="1200"
        Background="#F8F8FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#1F2937">

            <TextBlock Text="{Binding ApplicationTitle}"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="25,0,0,0"/>

        </Border>

        <!-- Navigation -->

        <Border Grid.Row="1"
                Background="#F8F8FA">

            <StackPanel Orientation="Horizontal"
                        Margin="15,5">

                <Button Content="Dashboard"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"/>

                <Button Content="Companies"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"/>

                <Button Content="Applications"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"/>

                <Button Content="Interviews"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"/>

            </StackPanel>

       

            </Border>

            <views:DashboardView Grid.Row="2"/>

        
    </Grid>

</Window>