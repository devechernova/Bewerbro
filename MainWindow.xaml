<Window x:Class="Bewerbro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bewerbro"
        mc:Ignorable="d"
        Title="Bewerbro"
        Height="700"
        Width="1200"
        Background="#F8F8FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#1F2937">

            <TextBlock Text="{Binding ApplicationTitle}"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="25,0,0,0"/>

        </Border>

        <!-- NAVIGATION -->

        <Border Grid.Row="1"
                Background="#F8F8FA">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0">

                <Button Content="Dashboard"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"
                        Padding="10,0"/>

                <Button Content="Companies"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"
                        Padding="10,0"/>

                <Button Content="Applications"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"
                        Padding="10,0"/>

                <Button Content="Interviews"
                        Width="120"
                        Height="34"
                        Margin="5"
                        Background="#DFE0E5"
                        BorderThickness="0"
                        Padding="10,0"/>

            </StackPanel>

        </Border>

        <!-- DASHBOARD -->

        <Grid Grid.Row="2"
              Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bewerbungen -->

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="16"
                    Padding="20"
                    Background="#DFE0E5"
                    CornerRadius="18">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Bewerbungen"
                               FontSize="18"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="0"
                               FontSize="46"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Interviews -->

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="16"
                    Padding="20"
                    Background="#C5C0C9"
                    CornerRadius="18">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Interviews"
                               FontSize="18"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="0"
                               FontSize="46"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Zusagen -->

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="16"
                    Padding="20"
                    Background="#8A7C9C"
                    CornerRadius="18">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Zusagen"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="0"
                               FontSize="46"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Absagen -->

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="16"
                    Padding="20"
                    Background="#4D3F72"
                    CornerRadius="18">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Absagen"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="0"
                               FontSize="46"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>